generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  username     String    @unique
  password     String
  role         String    @default("user")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  emailVerified Boolean  @default(false)
  firstName     String?
  lastName      String?
  bio           String?
  avatarType    String?  @default("preset1") // preset1, preset2, preset3, custom
  avatarUrl     String?  // alleen gebruikt als avatarType = custom
  street        String?
  houseNumber   String?
  houseNumberAddition String?
  postalCode    String?
  city          String?
  paymentsAsBuyer  Payment[] @relation("BuyerPayments")
  paymentsAsSeller Payment[] @relation("SellerPayments")

  listings     SeedListing[]
  auctionBids  AuctionBid[]
  tradesSent   TradeRequest[] @relation("TradeSender")
  tradesReceived TradeRequest[] @relation("TradeReceiver")
  resetTokens  PasswordResetToken[]
  reviewsGiven    Review[]  @relation("ReviewerReviews")
  reviewsReceived Review[]  @relation("SellerReviews")
  messagesSent     Message[] @relation("MessageSender")
  messagesReceived Message[] @relation("MessageReceiver")
  verificationTokens EmailVerificationToken[]
  mollieAccessToken   String?
  mollieRefreshToken  String?
  mollieOrganizationId String?
  mollieOnboarded     Boolean @default(false)
  favorites    Favorite[]
  wantedListings WantedListing[]
}

model SeedCategory {
  id          String    @id @default(cuid())
  name        String    @unique
  description String?
  species     SeedSpecies[]
}

model SeedSpecies {
  id          String    @id @default(cuid())
  name        String
  latinName   String?
  categoryId  String
  category    SeedCategory @relation(fields: [categoryId], references: [id])
  listings    SeedListing[]
  wantedBy    WantedListing[]

  @@unique([name, categoryId])
}

model SeedListing {
  id            String    @id @default(cuid())
  title         String
  description   String?
  quantity      Int       @default(1)
  quantityUnit  String    @default("zaadjes") // "zaadjes" of "gram"
  isHeirloom    Boolean   @default(true)
  listingType   String    @default("sale")
  price         Float?
  originCountry String?
  plantingMonth String?
  trackingCode  String?   // optioneel, alleen als verkoper Track&Trace gebruikt
  seedHistory   String?   // teeltgeschiedenis, bijv. "3 generaties open-pollinated"
  parentPlantYear Int?    // jaar van de moederplant/eerste selectie
  status        String    @default("active")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  ownerId       String
  owner         User      @relation(fields: [ownerId], references: [id])

  speciesId     String
  species       SeedSpecies @relation(fields: [speciesId], references: [id])

  auction       Auction?
  tradeRequests TradeRequest[]
  photos        Photo[]
  payments      Payment[]
  favoritedBy   Favorite[]
}

model Auction {
  id          String    @id @default(cuid())
  listingId   String    @unique
  listing     SeedListing @relation(fields: [listingId], references: [id])
  startPrice  Float
  endsAt      DateTime
  status      String    @default("open")
  bids        AuctionBid[]
}

model AuctionBid {
  id          String    @id @default(cuid())
  auctionId   String
  auction     Auction   @relation(fields: [auctionId], references: [id])
  bidderId    String
  bidder      User      @relation(fields: [bidderId], references: [id])
  amount      Float
  createdAt   DateTime  @default(now())
}

model TradeRequest {
  id            String    @id @default(cuid())
  listingId     String
  listing       SeedListing @relation(fields: [listingId], references: [id])

  senderId      String
  sender        User      @relation("TradeSender", fields: [senderId], references: [id])

  receiverId    String
  receiver      User      @relation("TradeReceiver", fields: [receiverId], references: [id])

  offerDescription String
  status        String    @default("pending")
  createdAt     DateTime  @default(now())
}

model PasswordResetToken {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  token       String    @unique
  expiresAt   DateTime
  used        Boolean   @default(false)
  createdAt   DateTime  @default(now())
}

model Review {
  id          String    @id @default(cuid())
  sellerId    String
  seller      User      @relation("SellerReviews", fields: [sellerId], references: [id])
  reviewerId  String
  reviewer    User      @relation("ReviewerReviews", fields: [reviewerId], references: [id])
  rating      Int       // 1-5
  comment     String?
  photoUrl    String?
  createdAt   DateTime  @default(now())

  @@unique([sellerId, reviewerId])
}

model Message {
  id          String    @id @default(cuid())
  senderId    String
  sender      User      @relation("MessageSender", fields: [senderId], references: [id])
  receiverId  String
  receiver    User      @relation("MessageReceiver", fields: [receiverId], references: [id])
  content     String
  read        Boolean   @default(false)
  createdAt   DateTime  @default(now())
}

model EmailVerificationToken {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  token       String    @unique
  expiresAt   DateTime
  used        Boolean   @default(false)
  createdAt   DateTime  @default(now())
}

model Photo {
  id          String    @id @default(cuid())
  url         String
  listingId   String
  listing     SeedListing @relation(fields: [listingId], references: [id])
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
}

model Payment {
  id            String    @id @default(cuid())
  listingId     String
  listing       SeedListing @relation(fields: [listingId], references: [id])

  buyerId       String
  buyer         User      @relation("BuyerPayments", fields: [buyerId], references: [id])

  sellerId      String
  seller        User      @relation("SellerPayments", fields: [sellerId], references: [id])

  amount        Float
  status        String    @default("held") // held, released, disputed, refunded

  shippedAt     DateTime?
  trackingCode  String?
  releaseAt     DateTime?
  releasedAt    DateTime?

  dispute       Dispute?

  createdAt     DateTime  @default(now())
}

model Dispute {
  id          String    @id @default(cuid())
  paymentId   String    @unique
  payment     Payment   @relation(fields: [paymentId], references: [id])
  reason      String    // "not_received", "damaged", "not_as_described"
  buyerNote   String?
  sellerNote  String?
  status      String    @default("open") // open, resolved_buyer, resolved_seller
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?
}

model Favorite {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  listingId   String
  listing     SeedListing @relation(fields: [listingId], references: [id])
  createdAt   DateTime  @default(now())

  @@unique([userId, listingId])
}

model WantedListing {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  speciesId   String
  species     SeedSpecies @relation(fields: [speciesId], references: [id])
  description String?
  status      String    @default("active") // active, fulfilled
  createdAt   DateTime  @default(now())
}